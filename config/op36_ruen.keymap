#include "keys_ru.h"

// 2.5K display: raise max cursor speed (default 600). Applies to the MOVE_*
// macros = the default (ramping) mouse mode speed.
#define ZMK_POINTING_DEFAULT_MOVE_VAL 900

// Slow-mouse mode speed (&mmv_slow on the mouse_slow layer, left thumb).
#define MOVE_LEFT_SLOW  MOVE_X(-300)
#define MOVE_RIGHT_SLOW MOVE_X(300)
#define MOVE_UP_SLOW    MOVE_Y(-300)
#define MOVE_DOWN_SLOW  MOVE_Y(300)

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>

&mt {
    quick-tap-ms = <200>;
    flavor = "tap-preferred";
    require-prior-idle-ms = <125>;
};

/ {
    behaviors {
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <5 6 7 8 9 15 16 17 18 19 25 26 27 28 29 33 34 35>;
            hold-trigger-on-release;
        };

        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 30 31 32>;
            hold-trigger-on-release;
        };

        // Mouse-move behaviors. Ramping (accel exponent 2) is now the DEFAULT;
        // &mmv_slow is a slower constant-speed mode (left thumb, mouse_slow
        // layer). Speed is encoded in the binding params (MOVE_* macros):
        // MOVE_* = ZMK_POINTING_DEFAULT_MOVE_VAL (900), MOVE_*_SLOW = 300.
        // acceleration-exponent: 0 = constant speed, 1 = linear ramp, 2 = aggressive ramp.
        mmv_acc: mmv_acc {
            compatible = "zmk,behavior-input-two-axis";
            #binding-cells = <1>;
            x-input-code = <INPUT_REL_X>;
            y-input-code = <INPUT_REL_Y>;
            time-to-max-speed-ms = <300>;
            acceleration-exponent = <2>;
        };

        mmv_slow: mmv_slow {
            compatible = "zmk,behavior-input-two-axis";
            #binding-cells = <1>;
            x-input-code = <INPUT_REL_X>;
            y-input-code = <INPUT_REL_Y>;
            time-to-max-speed-ms = <300>;
            acceleration-exponent = <0>;
        };
    };

    mmv_acc_input_listener {
        compatible = "zmk,input-listener";
        device = <&mmv_acc>;
    };

    mmv_slow_input_listener {
        compatible = "zmk,input-listener";
        device = <&mmv_slow>;
    };

    combos {
        compatible = "zmk,combos";

        // RMK combos (decoded from op36_hrm.entlayout): O+P -> Х, M+comma -> Ъ.
        // Trigger keys identified by their base-layer keycaps (Щ/З at O/P,
        // Ь/Б at M/comma) = key positions 8,9 and 26,27.
        kha {
            bindings = <&kp RU_CYRILLIC_HA>;
            key-positions = <8 9>;
            layers = <1>;
            timeout-ms = <75>;
        };

        hrdsgn {
            bindings = <&kp RU_CYRILLIC_HARD_SIGN>;
            key-positions = <26 27>;
            layers = <1>;
            timeout-ms = <75>;
        };

        // E+R language-switch combo — disabled for now; re-enable by uncommenting.
        // cmben {
        //     bindings = <&layer_en>;
        //     key-positions = <2 3>;
        //     layers = <1>;
        //     timeout-ms = <75>;
        // };

        // cmbru {
        //     bindings = <&layer_ru>;
        //     key-positions = <2 3>;
        //     layers = <0>;
        //     timeout-ms = <75>;
        // };
    };

    macros {
        // Sends the OS "switch to layout N" shortcut so the OS layout flips together
        // with the ZMK layer. IMPORTANT: use DIGITS, not letters — the Russian OS
        // layout remaps letter keys (E -> Cyrillic у), which breaks keysym-matched
        // shortcuts (KDE bindsym/sway bindsym) when switching back from RU.
        //   EN: Meta+Ctrl+1   RU: Meta+Ctrl+2
        // Assign in KDE: System Settings -> Keyboard -> Keyboard Shortcuts:
        //   "Switch keyboard layout to English (US)" = Meta+Ctrl+1
        //   "Switch keyboard layout to Russian"      = Meta+Ctrl+2
        // Sway: bindsym $mod+ctrl+1 / $mod+ctrl+2 -> xkb_switch_layout 0 / 1
        to_ru: to_ru {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(LC(N2))>;
            label = "TO_RU";
            wait-ms = <0>;
            tap-ms = <30>;
        };

        to_en: to_en {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(LC(N1))>;
            label = "TO_EN";
            wait-ms = <0>;
            tap-ms = <30>;
        };

        layer_en: layer_en {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0 &to_en>;
            label = "LAYER_EN";
            wait-ms = <0>;
            tap-ms = <30>;
        };

        layer_ru: layer_ru {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 1 &to_ru>;
            label = "LAYER_RU";
            tap-ms = <30>;
            wait-ms = <0>;
        };

        en: en {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&to_en>,
                <&macro_press>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_tap>,
                <&to_ru>;

            label = "EN";
            wait-ms = <0>;
            tap-ms = <30>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        en {
            bindings = <
  &kp Q        &kp W        &kp E         &kp R         &kp T                            &kp Y  &kp U          &kp I         &kp O        &kp P
  &hml LGUI A  &hml LALT S  &hml LSHFT D  &hml LCTRL F  &kp G                            &kp H  &hmr RCTRL J   &hmr RSHFT K  &hmr LALT L  &hmr RGUI SEMICOLON
  &kp Z        &kp X        &kp C         &kp V         &kp B                            &kp N  &kp M          &kp COMMA     &kp DOT      &kp SQT
                                          &kp TAB       &mo 4  &kp SPACE    &lt 6 ENTER  &mo 2  &kp BACKSPACE
            >;

            display-name = "Base";
        };

        ru {
            bindings = <
  &kp RU_CYRILLIC_SHORT_I   &kp RU_CYRILLIC_TSE         &kp RU_CYRILLIC_U          &kp RU_CYRILLIC_KA        &kp RU_CYRILLIC_IE                            &kp RU_CYRILLIC_EN  &kp RU_CYRILLIC_GHE        &kp RU_CYRILLIC_SHA        &kp RU_CYRILLIC_SHCHA     &kp RU_CYRILLIC_ZE
  &hml LGUI RU_CYRILLIC_EF  &hml LALT RU_CYRILLIC_YERU  &hml LSHFT RU_CYRILLIC_VE  &hml LCTRL RU_CYRILLIC_A  &kp RU_CYRILLIC_PE                            &kp RU_CYRILLIC_ER  &hmr RCTRL RU_CYRILLIC_O   &hmr RSHFT RU_CYRILLIC_EL  &hmr LALT RU_CYRILLIC_DE  &hmr RGUI RU_CYRILLIC_ZHE
  &kp RU_CYRILLIC_YA        &kp RU_CYRILLIC_CHE         &kp RU_CYRILLIC_ES         &kp RU_CYRILLIC_EM        &kp RU_CYRILLIC_I                             &kp RU_CYRILLIC_TE  &kp RU_CYRILLIC_SOFT_SIGN  &kp RU_CYRILLIC_BE         &kp RU_CYRILLIC_YU        &kp RU_CYRILLIC_E
                                                                                   &kp TAB                   &mo 4               &kp SPACE    &lt 6 ENTER  &mo 3               &kp BACKSPACE
            >;

            display-name = "Ru";
        };

        sym_en {
            bindings = <
  &kp TILDE   &kp LT     &kp EQUAL  &kp GT     &kp GRAVE                    &kp CARET  &kp LBKT  &kp COLON   &kp RBKT  &kp DLLR
  &kp BSLH    &kp LPAR   &kp MINUS  &kp RPAR   &kp PLUS                     &kp PRCNT  &kp SQT   &kp SEMI    &kp DQT   &kp EXCL
  &kp HASH    &kp STAR   &kp MINUS  &kp FSLH   &kp AMPS                     &kp AT     &kp PIPE  &kp COMMA   &kp DOT   &kp QMARK
                                                     &trans    &mo 5     &trans    &trans  &trans    &trans
            >;

            display-name = "Symbols";
        };

        sym_ru {
            bindings = <
  // Same RMK arrangement as sym_en; RU-correct keycodes (RU OS layout remaps
  // punctuation: ' -> э, / -> ., [ -> х, Shift+4 -> ; ...). Untypable-on-RU
  // symbols go through the &en macro (flip OS to EN, tap, flip back).
  &en TILDE   &en LT     &kp EQUAL  &en GT     &en GRAVE                    &en CARET  &en LBRC  &kp RU_COLON   &en RBRC  &en DLLR
  &kp RU_BSLH  &kp RU_LPAR  &kp MINUS  &kp RU_RPAR  &kp RU_PLUS              &kp PRCNT  &en SQT   &kp RU_SEMI    &kp RU_DQT   &kp EXCL
  &kp HASH    &kp STAR   &kp MINUS  &kp RU_FSLH   &en AMPS                  &en AT     &en PIPE  &kp RU_COMMA   &kp RU_DOT   &kp RU_QMARK
                                                     &trans    &mo 5     &trans    &trans  &trans    &trans
            >;

            display-name = "Symbols";
        };

        nav {
            bindings = <
  &kp N1         &kp N2          &kp N3        &kp N4     &kp N5                        &kp N6           &kp N7           &kp N8           &kp N9        &kp N0
  &hml LGUI ESC  &kp LALT        &kp LSHFT     &kp LCTRL  &trans                        &kp PRINTSCREEN  &hmr RCTRL LEFT  &hmr RSHFT DOWN  &hmr LALT UP  &hmr RGUI RIGHT
  &layer_en      &msc SCRL_DOWN  &msc SCRL_UP  &trans     &trans                        &trans           &trans           &trans           &kp PERIOD    &layer_ru
                                               &trans     &none   &trans    &caps_word  &mo 5            &kp CAPS
            >;

            display-name = "Nav";
        };

        adj {
            bindings = <
  &bootloader  &kp F1        &kp F2         &kp F3         &kp F4                     &bt BT_SEL 0  &bt BT_SEL 1         &bt BT_SEL 2       &bt BT_SEL 3        &bt BT_SEL 4
  &kp LGUI     &hml LALT F5  &hml LSHFT F6  &hml LCTRL F7  &kp F8                     &out OUT_BLE  &hmr RCTRL C_VOL_DN  &hmr RSHFT C_MUTE  &hmr LALT C_VOL_UP  &kp RGUI
  &bt BT_CLR   &kp F9        &kp F10        &kp F11        &kp F12                    &out OUT_USB  &kp C_PREV           &kp C_PP           &kp C_NEXT          &studio_unlock
                                            &trans         &trans   &trans    &trans  &trans        &trans
            >;

            display-name = "Adjust";
        };

        // Default mouse layer: RAMPING movement (accel exponent 2) at speed 900.
        // Left thumb -> slow mode (layer 7); right thumb -> reset to this layer.
        mouse {
            bindings = <
  &trans    &trans          &trans        &trans    &trans                      &trans  &trans          &trans          &trans        &trans
  &mkp MB2  &msc SCRL_DOWN  &msc SCRL_UP  &mkp MB1  &mkp MB3                    &trans  &mmv_acc MOVE_LEFT  &mmv_acc MOVE_DOWN  &mmv_acc MOVE_UP  &mmv_acc MOVE_RIGHT
  &trans    &trans          &trans        &trans    &trans                      &trans  &trans          &trans          &trans        &trans
                                          &trans    &to 7     &trans    &trans  &to 6     &trans
            >;

            display-name = "Mouse";
        };

        // Slow mouse mode (left thumb): constant speed 300, for precision.
        mouse_slow {
            bindings = <
  &trans    &trans          &trans        &trans    &trans                      &trans  &trans          &trans          &trans        &trans
  &mkp MB2  &msc SCRL_DOWN  &msc SCRL_UP  &mkp MB1  &mkp MB3                    &trans  &mmv_slow MOVE_LEFT_SLOW  &mmv_slow MOVE_DOWN_SLOW  &mmv_slow MOVE_UP_SLOW  &mmv_slow MOVE_RIGHT_SLOW
  &trans    &trans          &trans        &trans    &trans                      &trans  &trans          &trans          &trans        &trans
                                          &trans    &to 7     &trans    &trans  &to 6     &trans
            >;

            display-name = "Mouse (slow)";
        };
    };
};
