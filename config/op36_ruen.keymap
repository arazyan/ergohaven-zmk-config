#include "keys_ru.h"

// 2.5K display: raise max cursor speed (default 600). This is the DEFAULT
// (ramping) mouse speed; precision mode is derived as half of it.

#define ZMK_POINTING_DEFAULT_MOVE_VAL 1300

// Precision mouse mode: momentary layer (hold left thumb on the mouse layer).

#define MOVE_LEFT_PREC  MOVE_X(-(ZMK_POINTING_DEFAULT_MOVE_VAL / 2))
#define MOVE_RIGHT_PREC MOVE_X(ZMK_POINTING_DEFAULT_MOVE_VAL / 2)
#define MOVE_UP_PREC    MOVE_Y(-(ZMK_POINTING_DEFAULT_MOVE_VAL / 2))
#define MOVE_DOWN_PREC  MOVE_Y(ZMK_POINTING_DEFAULT_MOVE_VAL / 2)

#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    quick-tap-ms = <200>;
    flavor = "tap-preferred";
    require-prior-idle-ms = <125>;
};

/ {
    behaviors {
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <5 6 7 8 9 15 16 17 18 19 25 26 27 28 29 33 34 35>;
            hold-trigger-on-release;
        };

        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 30 31 32>;
            hold-trigger-on-release;
        };

        // Mouse-move behaviors. The mouse layer uses ramping (&mmv_acc, accel
        // exponent 2) at MOVE_* speed; holding the left thumb momentary-layers
        // the precision mode (&mmv_prec: constant speed, half of base) on top.
        // Speed lives in the binding params (v0.3.0 encodes per-axis speed there):
        // MOVE_* = ZMK_POINTING_DEFAULT_MOVE_VAL (1300), MOVE_*_PREC = 650.
        // acceleration-exponent: 0 = constant speed, 1 = linear ramp, 2 = aggressive ramp.

        mmv_acc: mmv_acc {
            compatible = "zmk,behavior-input-two-axis";
            #binding-cells = <1>;
            x-input-code = <INPUT_REL_X>;
            y-input-code = <INPUT_REL_Y>;
            time-to-max-speed-ms = <300>;
            acceleration-exponent = <2>;
        };

        mmv_prec: mmv_prec {
            compatible = "zmk,behavior-input-two-axis";
            #binding-cells = <1>;
            x-input-code = <INPUT_REL_X>;
            y-input-code = <INPUT_REL_Y>;
            time-to-max-speed-ms = <300>;
            acceleration-exponent = <0>;
        };
    };

    mmv_acc_input_listener {
        compatible = "zmk,input-listener";
        device = <&mmv_acc>;
    };

    mmv_prec_input_listener {
        compatible = "zmk,input-listener";
        device = <&mmv_prec>;
    };

    combos {
        compatible = "zmk,combos";

        // RMK combos (decoded from op36_hrm.entlayout): O+P -> Х, M+comma -> Ъ.
        // Trigger keys identified by their base-layer keycaps (Щ/З at O/P,
        // Ь/Б at M/comma) = key positions 8,9 and 26,27.

        kha {
            bindings = <&kp RU_CYRILLIC_HA>;
            key-positions = <8 9>;
            layers = <1>;
            timeout-ms = <75>;
        };

        hrdsgn {
            bindings = <&kp RU_CYRILLIC_HARD_SIGN>;
            key-positions = <26 27>;
            layers = <1>;
            timeout-ms = <75>;
        };

        // E+R language-switch combo — disabled for now. If re-enabled, bind to
        // &cycle_lang (relative cycle): a single node would then suffice, since
        // the cycle is direction-agnostic. The old absolute pair is below.
        // cmben {
        //     bindings = <&layer_en>;
        //     key-positions = <2 3>;
        //     layers = <1>;
        //     timeout-ms = <75>;
        // };
        // cmbru {
        //     bindings = <&layer_ru>;
        //     key-positions = <2 3>;
        //     layers = <0>;
        //     timeout-ms = <75>;
        // };
    };

    macros {
        // ===== Layout-switching design =====
        // Invariant kept by construction: ZMK `ru` layer ON == OS layout Russian.
        // - PRIMARY: dedicated DIRECTIONAL switch keys, one pair per language
        //   state, via two nav copies: "nav" (layer 4, held from the EN base)
        //   and "nav_ru" (layer 8, held from the RU base). The key for the
        //   OPPOSITE language cycles: Super+Space + &to N flips OS layout and
        //   ZMK base in lockstep (zero keybind config; needs exactly 2 sources).
        //   The key for the CURRENT language re-asserts (&to_en/&to_ru absolute
        //   combo — no-op on generic hosts, heals desync where keybinds exist).
        // - RECOVERY: &layer_en / &layer_ru on the adj layer outer thumbs.
        //   ABSOLUTE: force the ZMK base layer (and the OS layout where the
        //   Meta+Ctrl+1/2 shortcut is bound; harmless no-op where it is not).
        //   Use when parity is lost: after jumping to a PC already on the other
        //   layout (press the anchor matching the layout the OS shows), or after
        //   anyone switches layout via OS tray/manual Win+Space.
        // - Never change the layout from the OS side while this keyboard is the
        //   input authority — it silently breaks parity.
        //
        // to_en/to_ru: absolute OS shortcut Meta+Ctrl+1 / Meta+Ctrl+2. Digits,
        // not letters — the RU layout remaps letters (E -> Cyrillic у), which
        // breaks keysym-matched shortcuts when pressed from RU.
        //   KDE: "Switch keyboard layout to English (US)" = Meta+Ctrl+1,
        //        "...to Russian" = Meta+Ctrl+2
        //   Sway: bindsym $mod+ctrl+1 / $mod+ctrl+2 -> xkb_switch_layout 0 / 1

        to_ru: to_ru {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(LC(N2))>;
            label = "TO_RU";
            wait-ms = <0>;
            tap-ms = <30>;
        };

        to_en: to_en {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(LC(N1))>;
            label = "TO_EN";
            wait-ms = <0>;
            tap-ms = <30>;
        };

        // Directional cycle macros: flip OS layout (Super+Space) and force the
        // ZMK base via &to N. &to also clears the held nav momentary layer off
        // the stack, so the switch key never strands a layer under a held thumb.
        cycle_to_ru: cycle_to_ru {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(SPACE) &to 1>;
            label = "CYCLE_TO_RU";
            wait-ms = <0>;
            tap-ms = <30>;
        };

        cycle_to_en: cycle_to_en {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(SPACE) &to 0>;
            label = "CYCLE_TO_EN";
            wait-ms = <0>;
            tap-ms = <30>;
        };

        // Generic lockstep cycle (direction-agnostic): flips OS + ZMK together
        // via &tog. Currently unbound — reserved, e.g. for a re-enabled E+R combo
        // on layers that don't know the current base language.
        cycle_lang: cycle_lang {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(SPACE) &tog 1>;
            label = "CYCLE_LANG";
            wait-ms = <0>;
            tap-ms = <30>;
        };

        layer_en: layer_en {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0 &to_en>;
            label = "LAYER_EN";
            wait-ms = <0>;
            tap-ms = <30>;
        };

        layer_ru: layer_ru {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 1 &to_ru>;
            label = "LAYER_RU";
            tap-ms = <30>;
            wait-ms = <0>;
        };

        // Types a symbol that the RU layout has no key for: relative-flips the
        // OS to EN (Super+Space), taps the parameter keycode on the EN layout,
        // then flips back to RU on release. ZMK layers untouched — parity holds.

        en: en {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&kp LG(SPACE)>,
                <&macro_press>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_tap>,
                <&kp LG(SPACE)>;

            label = "EN";
            wait-ms = <0>;
            tap-ms = <30>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        en {
            bindings = <
  &kp Q        &kp W        &kp E         &kp R         &kp T                            &kp Y  &kp U          &kp I         &kp O        &kp P
  &hml LGUI A  &hml LALT S  &hml LSHFT D  &hml LCTRL F  &kp G                            &kp H  &hmr RCTRL J   &hmr RSHFT K  &hmr LALT L  &hmr RGUI SEMICOLON
  &kp Z        &kp X        &kp C         &kp V         &kp B                            &kp N  &kp M          &kp COMMA     &kp DOT      &kp SLASH
                                          &kp TAB       &mo 4  &kp SPACE    &lt 6 ENTER  &mo 2  &kp BACKSPACE
            >;

            display-name = "Base";
        };

        ru {
            bindings = <
  &kp RU_CYRILLIC_SHORT_I   &kp RU_CYRILLIC_TSE         &kp RU_CYRILLIC_U          &kp RU_CYRILLIC_KA        &kp RU_CYRILLIC_IE                            &kp RU_CYRILLIC_EN  &kp RU_CYRILLIC_GHE        &kp RU_CYRILLIC_SHA        &kp RU_CYRILLIC_SHCHA     &kp RU_CYRILLIC_ZE
  &hml LGUI RU_CYRILLIC_EF  &hml LALT RU_CYRILLIC_YERU  &hml LSHFT RU_CYRILLIC_VE  &hml LCTRL RU_CYRILLIC_A  &kp RU_CYRILLIC_PE                            &kp RU_CYRILLIC_ER  &hmr RCTRL RU_CYRILLIC_O   &hmr RSHFT RU_CYRILLIC_EL  &hmr LALT RU_CYRILLIC_DE  &hmr RGUI RU_CYRILLIC_ZHE
  &kp RU_CYRILLIC_YA        &kp RU_CYRILLIC_CHE         &kp RU_CYRILLIC_ES         &kp RU_CYRILLIC_EM        &kp RU_CYRILLIC_I                             &kp RU_CYRILLIC_TE  &kp RU_CYRILLIC_SOFT_SIGN  &kp RU_CYRILLIC_BE         &kp RU_CYRILLIC_YU        &kp RU_CYRILLIC_E
                                                                                   &kp TAB                   &mo 8               &kp SPACE    &lt 6 ENTER  &mo 3               &kp BACKSPACE
            >;

            display-name = "Ru";
        };

        sym_en {
            bindings = <
  &kp TILDE  &kp LT    &kp EQUAL  &kp GT    &kp GRAVE                    &kp CARET  &kp LBKT  &kp COLON  &kp RBKT  &kp DLLR
  &kp BSLH   &kp LPAR  &kp MINUS  &kp RPAR  &kp PLUS                     &kp PRCNT  &kp SQT   &kp SEMI   &kp DQT   &kp EXCL
  &kp HASH   &kp STAR  &kp MINUS  &kp FSLH  &kp AMPS                     &kp AT     &kp PIPE  &kp COMMA  &kp DOT   &kp QMARK
                                  &trans    &mo 5      &trans    &trans  &trans     &trans
            >;

            display-name = "Symbols";
        };

        sym_ru {
            bindings = <
  &en TILDE    &en LT       &kp EQUAL  &en GT       &en GRAVE                      &en CARET  &en LBKT  &kp RU_COLON  &en RBKT    &en DLLR
  &kp RU_BSLH  &kp RU_LPAR  &kp MINUS  &kp RU_RPAR  &kp RU_PLUS                    &kp PRCNT  &en SQT   &kp RU_SEMI   &kp RU_DQT  &kp EXCL
  &kp HASH     &kp STAR     &kp MINUS  &kp RU_FSLH  &en AMPS                       &en AT     &en PIPE  &kp RU_COMMA  &kp RU_DOT  &kp RU_QMARK
                                       &trans       &mo 5        &trans    &trans  &trans     &trans
            >;

            display-name = "Symbols";
        };

        nav {
            bindings = <
  &kp N1       &kp N2          &kp N3        &kp N4     &kp N5                     &kp N6  &kp N7           &kp N8           &kp N9        &kp N0
  &kp LGUI     &kp LALT        &kp LSHFT     &kp LCTRL  &kp ESC                    &trans  &hmr RCTRL LEFT  &hmr RSHFT DOWN  &hmr LALT UP  &hmr RGUI RIGHT
  &to_en       &msc SCRL_DOWN  &msc SCRL_UP  &trans     &trans                     &trans  &trans           &trans           &kp PERIOD    &cycle_to_ru
                                             &trans     &trans   &trans    &trans  &mo 5   &trans
            >;

            display-name = "Nav";
        };

        adj {
            bindings = <
  &bootloader  &kp F1        &kp F2         &kp F3         &kp F4                     &bt BT_SEL 0  &bt BT_SEL 1         &bt BT_SEL 2       &bt BT_SEL 3        &bt BT_SEL 4
  &kp LGUI     &hml LALT F5  &hml LSHFT F6  &hml LCTRL F7  &kp F8                     &out OUT_BLE  &hmr RCTRL C_VOL_DN  &hmr RSHFT C_MUTE  &hmr LALT C_VOL_UP  &kp RGUI
  &bt BT_CLR   &kp F9        &kp F10        &kp F11        &kp F12                    &out OUT_USB  &kp C_PREV           &kp C_PP           &kp C_NEXT          &studio_unlock
                                            &layer_en      &trans   &trans    &trans  &trans        &layer_ru
            >;

            display-name = "Adjust";
        };

        // Default mouse layer: RAMPING movement (accel exponent 2) at speed 1000.
        // Hold left thumb (pos 31) = momentary precision mode (layer 7); release
        // = straight back to ramping. No latched states.

        mouse {
            bindings = <
  &trans    &trans          &trans        &trans    &trans                      &trans  &trans              &trans              &trans            &trans
  &mkp MB2  &msc SCRL_DOWN  &msc SCRL_UP  &mkp MB1  &mkp MB3                    &trans  &mmv_acc MOVE_LEFT  &mmv_acc MOVE_DOWN  &mmv_acc MOVE_UP  &mmv_acc MOVE_RIGHT
  &trans    &trans          &trans        &trans    &trans                      &trans  &trans              &trans              &trans            &trans
                                          &trans    &mo 7     &trans    &trans  &none   &trans
            >;

            display-name = "Mouse";
        };

        // Precision mouse mode: constant speed (500 = half of base), active only
        // while the left thumb is held (layer stacked over "mouse").

        mouse_precision {
            bindings = <
  &trans    &trans          &trans        &trans    &trans                      &trans  &trans                    &trans                    &trans                  &trans
  &mkp MB2  &msc SCRL_DOWN  &msc SCRL_UP  &mkp MB1  &mkp MB3                    &trans  &mmv_prec MOVE_LEFT_PREC  &mmv_prec MOVE_DOWN_PREC  &mmv_prec MOVE_UP_PREC  &mmv_prec MOVE_RIGHT_PREC
  &trans    &trans          &trans        &trans    &trans                      &trans  &trans                    &trans                    &trans                  &trans
                                          &trans    &mo 7     &trans    &trans  &none   &trans
            >;

            display-name = "Mouse (precision)";
        };

        // RU-state nav: copy of "nav", entered by the RU base thumb (&mo 8).
        // The two language keys swap roles: EN (pos 20) cycles back to EN,
        // RU (pos 29) re-asserts the current layout.
        nav_ru {
            bindings = <
  &kp N1       &kp N2          &kp N3        &kp N4     &kp N5                     &kp N6  &kp N7           &kp N8           &kp N9        &kp N0
  &kp LGUI     &kp LALT        &kp LSHFT     &kp LCTRL  &kp ESC                    &trans  &hmr RCTRL LEFT  &hmr RSHFT DOWN  &hmr LALT UP  &hmr RGUI RIGHT
  &cycle_to_en &msc SCRL_DOWN  &msc SCRL_UP  &trans     &trans                     &trans  &trans           &trans           &kp PERIOD    &to_ru
                                             &trans     &trans   &trans    &trans  &mo 5   &trans
            >;

            display-name = "Nav (RU)";
        };
    };
};
